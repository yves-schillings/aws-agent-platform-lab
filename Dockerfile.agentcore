# Build explicitly with docker buildx build --platform linux/arm64.
# AgentCore's HTTP contract is 0.0.0.0:8080 with /ping and /invocations.
FROM python:3.12-slim@sha256:02108f5d322dd89f1c9e552442c25acb0543dfdbc455693a5599624f20d9155d
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 LAB_DATA_DIR=/tmp/factory
WORKDIR /app
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
COPY requirements.txt pyproject.toml README.md ./
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ ./src/
# Run the checked-in application directly; dependencies are pinned above.
# This also keeps the packaged corpus relative to the application source.
ENV PYTHONPATH=/app/src
COPY corpus/ ./corpus/
COPY scenarios/ ./scenarios/
USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "aws_agent_platform_lab.agentcore"]
